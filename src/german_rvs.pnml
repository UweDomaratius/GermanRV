grf {
	grfid: "UD\00\01";
	name: string(STR_GRF_NAME);
	desc: string(STR_GRF_DESCRIPTION);
	version: 0;
	min_compatible_version: 0;
	
	param {
		param_cargo_capacity {
			type: int;
			name: string(STR_PARAM_CARGO_CAPACITY);
			desc: string(STR_PARAM_CARGO_CAPACITY_DESC);
			min_value: 1;
			max_value: 500;
			def_value: 100;
		}
	}
	param {
		param_passenger_capacity {
			type: int;
			name: string(STR_PARAM_PASSENGER_CAPACITY);
			desc: string(STR_PARAM_PASSENGER_CAPACITY_DESC);
			min_value: 1;
			max_value: 500;
			def_value: 100;
		}
	}
}




if (ttd_platform != PLATFORM_OPENTTD || openttd_version < version_openttd(14, 0)) {
	error(FATAL, REQUIRES_OPENTTD, string(STR_ERR_OPENTTD_VERSION));
	exit;
}

if (dynamic_engines == 0) {
	error(FATAL, USED_WITH, string(STR_ERR_DYNAMIC_ENGINES));
	exit;
}

if (traffic_side != TRAFFIC_SIDE_RIGHT) {
	error(WARNING, USED_WITH, string(STR_ERR_DRIVING_SIDE));
}

cargotable {
	PASS, COAL, MAIL, LVST, // passengers, mail, goods should always be in these locations for compatibility
	STEL, GOOD, TOUR, WOOD, // tourists are required for busses, the rest is then filled with whatever is needed
	// the next 5 rows plus SULP are bulk cargoes - needed to choose correct recoloring table
	AORE, CLAY, COKE, CORE,
	FERT, GRAI, GRVL, IORE,
	KAOL, LIME, MNO2, NITR,
	OLSD, PEAT, PHOS, POTA,
	PORE, SALT, SAND, SCRP,
	SULP, WDPR, PAPR, STAL,
	FRUT, OIL_, VEHI, NH3_,
	// liquids and compressed gases - tanks are given colored markers, so we need to be able to distinguish the different cargoes
	CHLO, C2H4, COAT, RUBR,
	MILK, RFPR, LYE_, O2__,
	ACID, N2__, FUEL, H2__,
	// further cargo types
	ALUM, COPR, BDMT, 
}

switch(FEAT_ROADVEHS, SELF, tram_cb_sound, extra_callback_info1)
{
	SOUND_EVENT_START: return sound("src/trambell.wav");
	return CB_RESULT_NO_SOUND;
}

template template_32(x, y) {
    //[left_x,  upper_y,    width,     height,     offset_x,     offset_y]
    [x,         y,          10,        28,           -4,         -11]
    [x+ 20,     y,          26,        28,          -17,         -14]
    [x+ 50,     y,          36,        28,          -18,         -20]
    [x+ 90,     y,          26,        28,           -9,         -15]
    [x+120,     y,          10,        28,           -4,         -11]
    [x+140,     y,          26,        28,          -16,         -16]
    [x+170,     y,          36,        28,          -18,         -20]
    [x+210,     y,          26,        28,           -8,         -16]
}


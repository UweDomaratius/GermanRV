	template_24(0,180)
}

spritegroup test_vehicle_simple_crate_group {
	loading: [test_vehicle_nothing, test_vehicle_crate];
	loaded:  [test_vehicle_nothing, test_vehicle_crate];
}

switch(FEAT_ROADVEHS, SELF, switch_spritestack4, 
	[STORE_TEMP(PALETTE_USE_DEFAULT, 0x100)]
)
{
	test_vehicle_base_on_top;
}

switch(FEAT_ROADVEHS, SELF, switch_spritestack3, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)]
)
{
	test_vehicle_flatbed_top;
}

switch(FEAT_ROADVEHS, SELF, switch_spritestack2, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | LOAD_TEMP(0), 0x100)]
)
{
	test_vehicle_simple_crate_group;
}

switch(FEAT_ROADVEHS, SELF, switch_spritestack1, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)]
)
{
	test_vehicle_flatbed;
}

switch(FEAT_ROADVEHS, SELF, switch_spritestack0, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)]
)
{
	test_vehicle_base;
}

// extra_callback_info1 contains iteration of sprite stacking
// 0: draw vehicle as 2cc
// 1: draw bulk cargo
switch(FEAT_ROADVEHS, SELF, switch_test_graphics, 
	[STORE_TEMP(cb_colour_bulk_freight(),0),
	 getbits(extra_callback_info1, 8, 8)])
{
	1: switch_spritestack1;	// base of the structure (e.g. flatbed, tanker, ...)
	2: switch_spritestack2; // load on the structure (e.g. crate, container, bulk load)
	3: switch_spritestack3; // front part of the structure
	4: switch_spritestack4; // front part of the vehicle
	switch_spritestack0;    // vehicle base
}


// open
item(FEAT_ROADVEHS, ID_0815_BUSSING_VIGL_open) {
	property{
		name: string(TRUCK_BUSSING_VIGL_OPEN);
		introduction_date:date(1920,01,01);
		reliability_decay:23;
		vehicle_life:10;
        model_life:20;
        loading_speed:3;
        climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC);
        speed:50 km/h;
        running_cost_factor:7;
        running_cost_base:RUNNING_COST_ROADVEH;
        sprite_id:SPRITE_ID_NEW_ROADVEH;
        cargo_capacity:7;
		default_cargo_type:COAL;
		cost_factor:4;
		refit_cost:0;
		sound_effect:SOUND_DEPARTURE_OLD_RV_1;
		length:7;
        power:80 hp;
        weight:2.5 tons;
        tractive_effort_coefficient:0.3;
        air_drag_coefficient: 0;
        retire_early:7;
        misc_flags: bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_AUTOREFIT, ROADVEH_FLAG_SPRITE_STACK);
		refittable_cargo_classes:bitmask(CC_BULK, CC_PIECE_GOODS);
		non_refittable_cargo_classes:bitmask(CC_HAZARDOUS, CC_COVERED, CC_REFRIGERATED);
		variant_group: ID_34_BUSSING_VIGL_tarpaulin;
	}
	graphics {
		default: switch_test_graphics;
		//cargo_capacity: buessingVIGL_cb_cargo_capacity;
		additional_text: return string(STR_PURCHASE_MENU2, string(STR_CFG_TRUCK), string(STR_TRUCK_AUTOREFIT));
	}
}

spriteset(test_vehicle_base, "graphics/test_vehicle.pcx") {
	template_24(0,140)
}

spriteset(test_vehicle_base_on_top, "graphics/test_vehicle.pcx") {
	template_24(0,180)
}

// two spritesets for the actual bodywork
// drawing order: bodywork, then cargo, then second bodywork sprite
spriteset(truck_15px_open_flatbed, "graphics/cargo/15px_open_flatbed.pcx") {
	template_24(0,30)
}

spriteset(truck_15px_open_flatbed2, "graphics/cargo/15px_open_flatbed.pcx") {
	template_24(0,60)
}

spriteset(truck_15px_open_tarpaulin, "graphics/cargo/15px_open_flatbed.pcx") {
	template_24(0,540)
}

spriteset(truck_15px_open_tarpaulin_loading, "graphics/cargo/15px_open_flatbed.pcx") {
	template_24(0,600)
}

spriteset(truck_15px_open_tarpaulin_loading2, "graphics/cargo/15px_open_flatbed.pcx") {
	template_24(0,570)
}

spritegroup truck_15px_open_tarpaulin_group {
	loading: [truck_15px_open_tarpaulin_loading];
	loaded:  [truck_15px_open_tarpaulin];
}

spritegroup truck_15px_open_tarpaulin2_group {
	loading: [truck_15px_open_tarpaulin_loading2];
	loaded:  [truck_15px_open_tarpaulin];
}

// cargo sprites related to bodywork following here
// empty sprite, used to denote empty flatbed
spriteset(cargo_15px_open_flatbed_nothing, "graphics/cargo/15px_open_flatbed.pcx") {
	template_24(0,0)
}


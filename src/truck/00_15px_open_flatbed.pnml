random_switch(FEAT_ROADVEHS, SELF, switch_15px_open_flatbed_cargo_random_steel, bitmask(TRIGGER_VEHICLE_NEW_LOAD)) {
	1: cargo_15px_cable_drum_group;
	1: cargo_15px_light_grey_metal_group;
	1: cargo_15px_small_steel_coils_group;
	1: cargo_15px_big_pipe_group;
}

switch(FEAT_ROADVEHS, SELF, switch_15px_open_flatbed_cargo, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | LOAD_TEMP(0), 0x100),
	 cargo_type_in_veh
	]
)
{
	BDMT: cargo_15px_bricks_group;
	FRUT: cargo_15px_fruits_group;
	GOOD: cargo_15px_big_crate_group;
	STEL: switch_15px_open_flatbed_cargo_random_steel;
	WDPR: cargo_15px_timber_group;
	WOOD: cargo_15px_wooden_logs_group;
	cargo_15px_2crates_group;
}

switch(FEAT_ROADVEHS, SELF, switch_15px_open_flatbed, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)]
)
{
	truck_15px_open_flatbed;
}

switch(FEAT_ROADVEHS, SELF, switch_15px_open_flatbed2, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)]
)
{
	truck_15px_open_flatbed2;
}

switch(FEAT_ROADVEHS, SELF, switch_15px_open_tarpaulin, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)]
)
{
	truck_15px_open_tarpaulin_group;
}

switch(FEAT_ROADVEHS, SELF, switch_15px_open_tarpaulin2, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)]
)
{
	truck_15px_open_tarpaulin2_group;
}

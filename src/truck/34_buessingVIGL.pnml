spriteset(buessingVIGL_base, "graphics/buessingVIGL.pcx") {
	template_24(0,0)
}

spriteset(buessingVIGL_base2, "graphics/buessingVIGL.pcx") {
	template_24(0,40)
}

switch(FEAT_ROADVEHS, SELF, buessingVIGL_graphics_base2, 
	[STORE_TEMP(PALETTE_USE_DEFAULT, 0x100)]
)
{
	buessingVIGL_base2;
}

switch(FEAT_ROADVEHS, SELF, buessingVIGL_graphics_base, 
	[STORE_TEMP(CB_FLAG_MORE_SPRITES | PALETTE_USE_DEFAULT, 0x100)]
)
{
	buessingVIGL_base;
}

switch(FEAT_ROADVEHS, SELF, buessingVIGL_graphics_dump, 
	[getbits(extra_callback_info1, 8, 8)])
{
	1: switch_15px_dump;	// base of the structure (e.g. flatbed, tanker, ...)
	2: switch_15px_dump_cargo; // load on the structure (e.g. crate, logs, steel parts, ...)
	3: switch_15px_dump2; // front part of the structure
	4: buessingVIGL_graphics_base2; // front part of the vehicle
	buessingVIGL_graphics_base;    // vehicle base
}

switch(FEAT_ROADVEHS, SELF, buessingVIGL_graphics_open_flatbed, 
	[getbits(extra_callback_info1, 8, 8)])
{
	1: switch_15px_open_flatbed;	// base of the structure (e.g. flatbed, tanker, ...)
	2: switch_15px_open_flatbed_cargo; // load on the structure (e.g. crate, logs, steel parts, ...)
	3: switch_15px_open_flatbed2; // front part of the structure
	4: buessingVIGL_graphics_base2; // front part of the vehicle
	buessingVIGL_graphics_base;    // vehicle base
}

switch(FEAT_ROADVEHS, SELF, buessingVIGL_graphics_open_tarpaulin, 
	[getbits(extra_callback_info1, 8, 8)])
{
	1: switch_15px_open_tarpaulin;	// base of the structure (e.g. flatbed, tanker, ...)
	2: switch_15px_open_flatbed_cargo; // load on the structure (e.g. crate, logs, steel parts, ...)
	3: switch_15px_open_tarpaulin2; // front part of the structure
	4: buessingVIGL_graphics_base2; // front part of the vehicle
	buessingVIGL_graphics_base;    // vehicle base
}

switch(FEAT_ROADVEHS, SELF, buessingVIGL_graphics_closed, 
	[getbits(extra_callback_info1, 8, 8)])
{
	1: switch_15px_closed;	// base of the structure (e.g. flatbed, tanker, ...)
	2: switch_15px_open_flatbed_cargo; // load on the structure (e.g. crate, logs, steel parts, ...)
	3: switch_15px_closed2; // front part of the structure
	4: buessingVIGL_graphics_base2; // front part of the vehicle
	buessingVIGL_graphics_base;    // vehicle base
}

switch(FEAT_ROADVEHS, SELF, buessingVIGL_graphics_tanker, 
	[getbits(extra_callback_info1, 8, 8)])
{
	1: switch_15px_tanker;	// base of the structure
	2: switch_15px_tanker2; // structure once more (to get recoloring right)
	3: buessingVIGL_graphics_base2; // front part of the vehicle
	buessingVIGL_graphics_base;    // vehicle base
}

switch(FEAT_ROADVEHS, SELF, buessingVIGL_cb_cargo_capacity, 
	[STORE_TEMP(param_cargo_capacity == 0 ? 100 : param_cargo_capacity, 0)]) {
	return (7 * 16 * LOAD_TEMP(0)) / (cargo_unit_weight*100);
}

// open
item(FEAT_ROADVEHS, ID_34_BUSSING_VIGL_dump) {
	property{
		name: string(TRUCK_BUSSING_VIGL_DUMP);
		introduction_date:date(1924,01,01);
		reliability_decay:23;
		vehicle_life:10;
        model_life:20;
        loading_speed:3;
        climates_available: bitmask(CLIMATE_TEMPERATE, CLIMATE_ARCTIC, CLIMATE_TROPIC);
        speed:50 km/h;
        running_cost_factor:7;
        running_cost_base:RUNNING_COST_ROADVEH;
        sprite_id:SPRITE_ID_NEW_ROADVEH;
        cargo_capacity:7;
		default_cargo_type:COAL;
		cost_factor:4;
		refit_cost:0;
		sound_effect:SOUND_DEPARTURE_OLD_RV_1;
		length:7;
        power:80 hp;
        weight:2.5 tons;
        tractive_effort_coefficient:0.3;
        air_drag_coefficient: 0;
        retire_early:7;
        misc_flags: bitmask(ROADVEH_FLAG_2CC, ROADVEH_FLAG_AUTOREFIT, ROADVEH_FLAG_SPRITE_STACK);
		refittable_cargo_classes:bitmask(CC_BULK);
		non_refittable_cargo_classes:bitmask(CC_HAZARDOUS, CC_COVERED, CC_REFRIGERATED);
		variant_group: ID_34_BUSSING_VIGL_tarpaulin;
	}
	graphics {
		default: buessingVIGL_graphics_dump;
		cargo_capacity: buessingVIGL_cb_cargo_capacity;
		additional_text: return string(STR_PURCHASE_MENU2, string(STR_CFG_TRUCK), string(STR_TRUCK_AUTOREFIT));
	}
}

